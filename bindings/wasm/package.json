{
  "name": "@stkcraft/time",
  "version": "0.1.34",
  "type": "module",
  "description": "Checked NAIF/SPICE and scientific astronomical time via WebAssembly",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./js/index.d.ts",
      "default": "./js/index.js"
    },
    "./node": {
      "types": "./js/node.d.ts",
      "default": "./js/node.js"
    }
  },
  "files": [
    "js",
    "pkg",
    "README.md",
    "API_INVENTORY.md",
    "LICENSE",
    "ATTRIBUTION.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/node.test.mjs",
    "test:types": "tsc --noEmit --strict --target ES2022 --module nodenext tests/types.ts",
    "test:browser": "node tests/browser.mjs",
    "test:consumer": "node tests/consumer.mjs",
    "test:node": "node --test tests/node.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.58.2",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spacelibres/STKCraft-time.git",
    "directory": "bindings/wasm"
  }
}
